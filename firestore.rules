rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザープロフィール: 本人のみ読み書き
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // グループ: メンバーのみ読み書き
    match /groups/{groupId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;
    }

    // 投稿: 同じグループのメンバーのみ読み書き
    match /posts/{postId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // コメント: 同じグループのメンバーのみ
      match /comments/{commentId} {
        allow read, create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(get(/databases/$(database)/documents/posts/$(postId)).data.groupId)).data.members;
      }
    }
  }
}
